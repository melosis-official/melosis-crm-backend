generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum InstituteType {
  COACHING_CENTRE
  COMPUTER_INSTITUTE
  COLLEGE
  SCHOOL
  OTHER
}
enum LeadSource {
  COLD_CALLING
  REFERRAL
  WHATSAPP
  WEBSITE
  LINKEDIN
  WALK_IN
  OTHER
}
enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  DEMO_SCHEDULED
  PILOT
  CUSTOMER
  NOT_INTERESTED
  LOST
}
enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}
enum ActivityType {
  CALL
  WHATSAPP
  EMAIL
  DEMO
  MEETING
  NOTE
  STATUS_CHANGE
  OTHER
}
enum CallOutcome {
  NO_ANSWER
  SPOKE_SUCCESSFULLY
  INTERESTED
  CALLBACK_REQUESTED
  NOT_INTERESTED
  WRONG_NUMBER
  OTHER
}
enum TaskType {
  FOLLOW_UP
  DEMO
  ONBOARDING
  OTHER
}
enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}
enum TaskStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum UserRole {
  SUPERADMIN
  USER
}

model User {
  id String @id @default(cuid())
  name String
  email String @unique
  passwordHash String
  role UserRole @default(USER)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  leads Lead[] @relation("LeadCreator")
  assignedLeads Lead[] @relation("LeadAssignee")
  activities Activity[]
  tasks Task[]
  previousAssignments LeadAssignmentHistory[] @relation("PreviousAssignments")
  receivedAssignments LeadAssignmentHistory[] @relation("NewAssignments")
  assignedByLogs LeadAssignmentHistory[] @relation("AssignedBy")
}

model Session {
  id String @id @default(cuid())
  userId String
  tokenHash String @unique
  csrfTokenHash String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  lastUsedAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
  @@index([userId])
}

model Lead {
  id String @id @default(cuid())
  instituteName String @db.VarChar(180)
  ownerName String? @db.VarChar(160)
  mobileNumber String @db.VarChar(40)
  normalizedMobileNumber String @db.VarChar(40)
  email String? @db.VarChar(254)
  location String? @db.VarChar(180)
  instituteType InstituteType @default(OTHER)
  source LeadSource @default(OTHER)
  status LeadStatus @default(NEW)
  hasBeenCalled Boolean @default(false)
  remarks String? @db.Text
  onboardingStatus OnboardingStatus @default(NOT_STARTED)
  convertedAt DateTime?
  customerNotes String? @db.Text
  createdById String
  assignedToId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  archivedAt DateTime?
  createdBy User @relation("LeadCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignedTo User? @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  activities Activity[]
  tasks Task[]
  assignmentHistory LeadAssignmentHistory[]
  @@index([status])
  @@index([normalizedMobileNumber])
  @@index([instituteName])
  @@index([createdAt])
  @@index([archivedAt])
  @@index([status, archivedAt])
  @@index([assignedToId])
}

model LeadAssignmentHistory {
  id String @id @default(cuid())
  leadId String
  previousUserId String?
  assignedToUserId String?
  assignedByUserId String
  notes String? @db.VarChar(255)
  createdAt DateTime @default(now())
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  previousUser User? @relation("PreviousAssignments", fields: [previousUserId], references: [id], onDelete: SetNull)
  assignedToUser User? @relation("NewAssignments", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  assignedByUser User @relation("AssignedBy", fields: [assignedByUserId], references: [id], onDelete: Restrict)
  @@index([leadId])
  @@index([assignedToUserId])
  @@index([createdAt])
}

model Activity {
  id String @id @default(cuid())
  leadId String
  userId String
  type ActivityType
  outcome CallOutcome?
  notes String? @db.Text
  occurredAt DateTime @default(now())
  createdAt DateTime @default(now())
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([leadId, occurredAt])
  @@index([occurredAt])
}

model Task {
  id String @id @default(cuid())
  leadId String
  userId String
  title String @db.VarChar(180)
  description String? @db.Text
  type TaskType @default(FOLLOW_UP)
  priority TaskPriority @default(MEDIUM)
  status TaskStatus @default(OPEN)
  dueAt DateTime
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([status, dueAt])
  @@index([leadId])
  @@index([userId, status, dueAt])
}
